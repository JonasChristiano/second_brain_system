# ─── PROVIDERS ────────────────────────────────────────────
# Deixe em branco as APIs que não usa. O provider ativo é BRAIN_DEFAULT_PROVIDER.

BRAIN_DEFAULT_PROVIDER=ollama           # openai | anthropic | ollama

# OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (opcional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Ollama (ativo)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# ─── BRAIN — MODELO PADRÃO ────────────────────────────────
BRAIN_MODEL=ollama:qwen3:4b             # formato provider:modelo

# ─── EMBEDDINGS ───────────────────────────────────────────
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=qwen3-embedding:4b   # modelo de embeddings local

# ─── VECTOR DB ────────────────────────────────────────────
VECTOR_DB=chroma                        # faiss | chroma | weaviate
VECTOR_DB_PATH=./rag/index

# ─── CAMINHOS ─────────────────────────────────────────────
BRAIN_BASE_DIR=/path/to/brain_system
BRAIN_VAULT_DIR=/path/to/brain_system/vault
BRAIN_SKILLS_DIR=/path/to/brain_system/skills
BRAIN_DOCS_DIR=/path/to/brain_system/docs

# ─── AMBIENTE ─────────────────────────────────────────────
BRAIN_ENV=development                   # development | production
BRAIN_DEBUG=true                        # logs detalhados

# ─── LOGGING ──────────────────────────────────────────────
BRAIN_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
BRAIN_LOG_FILE=logs/brain.log

# ─── VAULT WATCH ──────────────────────────────────────────
BRAIN_WATCH_INTERVAL=2                  # segundos
BRAIN_AUTO_COMMIT=true
BRAIN_GIT_BRANCH=main

# ─── LLM — LIMITES ────────────────────────────────────────
BRAIN_MAX_TOKENS=4000
BRAIN_TIMEOUT=30
BRAIN_RATE_LIMIT=60